# ============================================
# Placify Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to git

# ============================================
# AI API KEYS (Required)
# ============================================
# Get Gemini key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get Groq key: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# DATABASE (Required)
# ============================================
POSTGRES_USER=username_here
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=placify_db

# Connection string (used by FastAPI)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://username_here:your_secure_password_here@db:5432/placify_db

# ============================================
# PRODUCTION OPTIONS (Optional)
# ============================================
# Set to "true" in production to disable auto-seeding
# Companies should be seeded once via migration, not on every restart
SKIP_SEED=false

# Optional password to protect the /api/admin/reseed endpoint
ADMIN_SECRET=default_dev_secret
